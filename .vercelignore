########################################
# .vercelignore
#
# Vercel Hobby menghitung SETIAP file .js di folder api/ sebagai satu
# Serverless Function (batas 12). Karena itu seluruh API dilayani oleh satu
# file saja:
#
#   api/[...path].js   ← satu-satunya Serverless Function
#
# Semua handler asli (songs, setlists, bands, events, auth, users, tools) ada
# di server/handlers/ dan util bersama di server/.
#
# PENTING — jangan di-ignore:
#   api/ai.js       diimpor api/[...path].js (AI Autofill + Transcriber)
#   vite.config.js  dipakai `npm run build` (plugin React, manualChunks,
#                   define __APP_NAME__, filter modulePreload)
########################################

# === API: bukan function (dipakai lokal / test / legacy) ===
api/index.js
api/server.cjs
api/__tests__/
api/test-helpers/

# === Database, test, and dev files ===
db/
src/__tests__/
node_modules/
runMigration.js
.env*

# === Config & build/test scripts ===
# vite.config.js SENGAJA tidak di-ignore: build produksi membutuhkannya.
jest.config.*
vitest.config.js

# === Test & documentation files ===
*.test.js
*.spec.js
*.log
*.zip
*.sql
backups/
.DS_Store

# === Project docs & misc ===
docs/
scripts/
coverage/
dist/
.wrangler/
