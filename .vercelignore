########################################
# .vercelignore
#
# Vercel Hobby menghitung SETIAP file .js di folder api/ sebagai satu
# Serverless Function (batas 12). Karena itu seluruh API dilayani oleh satu
# file saja:
#
#   api/[...path].js   ← satu-satunya Serverless Function
#
# Semua handler asli (songs, setlists, bands, events, auth, users, tools) ada
# di server/handlers/ dan util bersama di server/. File lain di api/ di bawah
# ini hanya dipakai untuk pengembangan lokal, test, atau sisa struktur lama.
########################################

# === API: bukan function (dipakai lokal / test / legacy) ===
api/index.js
api/ai.js
api/server.cjs
api/__tests__/
api/test-helpers/

# === Database, test, and dev files ===
db/
src/__tests__/
node_modules/
runMigration.js
.env*
.env.local
.env.development

# === Config & build/test scripts ===
jest.config.*
vitest.config.js
vite.config.js

# === Test & documentation files ===
*.test.js
*.spec.js
*.md
*.MD
*.log
*.zip
*.sql
backups/
.DS_Store

# === Project docs & misc ===
docs/
scripts/
coverage/
dist/
.wrangler/
