########################################
# .vercelignore (cleaned & grouped)
########################################

# === API: Unused/disabled endpoints ===
# Vercel Hobby menghitung SETIAP file .js di folder api/ sebagai satu
# Serverless Function (maksimal 12). Karena itu hanya api/[...path].js yang
# memuat semua route; handler lainnya tinggal di server/handlers/.
# api/index.js, api/ai.js, api/tools/**, api/users/** tetap dipertahankan sebagai
# implementasi lokal/legacy dan di-ignore dari deployment.
api/index.js
api/server.cjs
api/ai.js
api/tools/
api/users/
api/__tests__/
api/test-helpers/

# === Database, test, and dev files ===
db/
src/__tests__/
node_modules/
runMigration.js
.env*
.env.local
.env.development

# === Config & build/test scripts ===
jest.config.*
vitest.config.js
vite.config.js

# === Test & documentation files ===
*.test.js
*.spec.js
*.md
*.MD
*.log
*.zip
*.sql
backups/
.DS_Store

# === Project docs & misc ===