{
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "extends": ["eslint:recommended", "plugin:react/recommended"],
  "parserOptions": {
    "ecmaFeatures": {
      "jsx": true
    },
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "plugins": ["react"],
  "rules": {
    "semi": ["error", "always"],
    "quotes": ["error", "single"],
    "no-unused-vars": "warn"
  },
  "overrides": [
    {
      "files": [
        "src/utils/chordUtils.js",
        "src/utils/lyricsEditorUtils.js",
        "src/utils/musicNotationUtils.js"
      ],
      "rules": {
        "no-useless-escape": "off"
      }
    },
    {
      "files": ["src/__tests__/**/*.js", "src/__tests__/**/*.jsx"],
      "env": {
        "jest": true,
        "node": true
      },
      "globals": {
        "vi": "readonly",
        "describe": "readonly",
        "it": "readonly",
        "test": "readonly",
        "expect": "readonly",
        "beforeEach": "readonly",
        "afterEach": "readonly",
        "beforeAll": "readonly",
        "afterAll": "readonly",
        "global": "readonly"
      },
      "rules": {
        "react/prop-types": "off",
        "react/display-name": "off"
      }
    }
  ]
}
